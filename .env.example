# Settings for local runs with `make run` (go run ./cmd/devtool run).
# Copy to .env and adjust. Variables already set in your shell win.
#
# devtool run never sends unless you pass -send, treats event codes as
# plaintext, and keeps rate limit and SMS history counters in memory unless
# you pass -aws. See docs/configuration.md for every variable.

APP_LOG_LEVEL=debug

# email sender
APP_EMAIL_SENDER_ENABLED=true
APP_EMAIL_SENDER_POLICY_PATH=examples/policies/email/route.rego
APP_EMAIL_PROVIDERS=ses
APP_EMAIL_VERIFICATION_ENABLED=true
APP_EMAIL_VERIFICATION_PROVIDER=offline
APP_EMAIL_VERIFICATION_ALLOWLIST=
APP_EMAIL_RATE_LIMIT_ENABLED=false
APP_EMAIL_RATE_LIMIT_CONFIG=

# sms sender
APP_SMS_SENDER_ENABLED=true
APP_SMS_SENDER_POLICY_PATH=examples/policies/sms/throttle.rego

# only needed with -aws or -send
# APP_KMS_KEY_ID=arn:aws:kms:us-east-1:111122223333:key/...
# APP_EMAIL_RATE_LIMIT_TABLE_NAME=
# APP_SMS_HISTORY_TABLE_NAME=
# APP_SENDGRID_API_HOST=https://api.sendgrid.com
# APP_SENDGRID_EMAIL_SEND_API_KEY=
# APP_SENDGRID_EMAIL_VERIFICATION_API_KEY=
